{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/*"],
      "@aurix/types": ["packages/types/index.ts"],
      "@aurix/types/*": ["packages/types/*"],
      "@aurix/supabase": ["packages/supabase/index.ts"],
      "@aurix/supabase/*": ["packages/supabase/*"],
      "@aurix/backend": ["packages/backend/index.ts"],
      "@aurix/backend/*": ["packages/backend/*"]
    }
  },
  "include": ["apps/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", ".next"]
}
