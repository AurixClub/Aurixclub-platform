# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Turborepo & Cache
.turbo
.cache

# Vercel Deployment
.vercel

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem
*.key
*.cert

# IDE Settings (allow sharing workspace extensions/settings if needed)
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
