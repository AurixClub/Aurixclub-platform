# =============================================================================
# AURIX CLUB PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env or .env.local and fill in your values.

# 1. Supabase Project Configuration (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Server-Only Service Role Key (Keep private, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Application URL (Default for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Super Admin Credentials (Optional overrides for seed initialization)
ADMIN_SEED_PASSWORD=Aurixclub@123
MEMBER_SEED_PASSWORD=Member@Secure2026
